# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://www.seadconsulting.fr

# --- Formulaire de contact / audit (au moins une des deux options) ---
# Option 1 : envoi d'emails via Resend (https://resend.com) — domaine d'envoi à vérifier chez Resend
RESEND_API_KEY=
LEAD_TO_EMAIL=contact@seadconsulting.fr
LEAD_FROM_EMAIL=SEAD CONSEIL <site@seadconsulting.fr>
# Option 2 : webhook (Make, Zapier, Google Apps Script -> Google Sheet, CRM…)
LEAD_WEBHOOK_URL=

# --- Mesure (chargée uniquement après consentement) ---
NEXT_PUBLIC_GA_ID=
# Conversion Google Ads déclenchée sur /merci, format AW-XXXXXXXXX/abcDEFghiJKL
NEXT_PUBLIC_ADS_CONVERSION=

# Lien de prise de rendez-vous (Calendly, Google Agenda…) — facultatif
NEXT_PUBLIC_BOOKING_URL=
